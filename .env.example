# Only needed if you run the program on your own computer.
# On GitHub you put these in Settings > Secrets instead (see README). Never commit a real .env file.

# Required for alerts
EMAIL_ADDRESS=your.sender@gmail.com
EMAIL_APP_PASSWORD=abcdefghijklmnop
RECIPIENT_EMAIL=where.alerts.go@example.com

# Optional: turns on the AI filter. Leave empty to use keywords only.
ANTHROPIC_API_KEY=

# Only for the optional auto-apply feature (docs/AUTO_APPLY.md)
DATABASE_URL=
DRY_RUN=true
